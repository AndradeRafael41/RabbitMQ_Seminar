# Nome da fila para comunicação RPC (síncrona)
QUEUE_RPC=fila_rpc

# Nome da fila para mensagens assíncronas
QUEUE_ASYNC=fila_async

# Timeout para requisições RPC em milissegundos
RPC_TIMEOUT=5000

