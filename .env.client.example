# Copie este arquivo para `.env` na raiz do repositório (lado do Windows)
# antes de rodar `docker compose -f docker-compose.client.yml ...`.
# O Compose carrega `.env` automaticamente.

# Endereço do broker (Linux que roda RabbitMQ)
RabbitMQ_HOST=200.235.92.106
RabbitMQ_PORT=5672

# Credenciais. ATENÇÃO: o usuário 'guest' do RabbitMQ, por padrão,
# só aceita conexões vindas de localhost (loopback_users = [guest]).
# Para acessar o broker de outra máquina:
#   - Crie um usuário dedicado no broker, OU
#   - Em rabbitmq.conf do broker: loopback_users = none
RabbitMQ_USER=guest
RabbitMQ_PASS=guest
RabbitMQ_VHOST=/

# Filas (devem bater com as do server)
QUEUE_RPC=fila_rpc
QUEUE_ASYNC=fila_async

# Timeout das chamadas RPC (ms) - aumente se a rede for lenta
RPC_TIMEOUT=10000
